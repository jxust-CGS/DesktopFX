# Python / 构建临时产物
__pycache__/
*.py[cod]
*.spec
build/

# PyInstaller 构建输出整个不入库。
# exe 作为 GitHub Release 资产分发（见 README「下载」），不再入库 ——
# 否则每次构建都会往 git 里塞一个 30MB 的 blob，仓库只会越来越胖。
# 同时这里也是运行数据目录（在 dist 里直接跑 exe 会生成 config.json 等）。
dist/

# 运行时个人数据（本地保留，不入库）
config.json
presets_user.json
ui_state.json
error.log
*.log

# WorkBuddy 项目数据（记忆 / 备份 / 项目级 skill），与运行无关
.workbuddy/

# 一次性实验产物
_patch_*.patch
_*_compare.png

# 开发期截图 / 预览产物（可由脚本重新生成，不入库）
_diag_A.png
_diag_B.png
_diag_screen.png
_diag_diff.png
_icon_preview_*.png
